# PatchPilot Server Environment Configuration

# Server Port
PORT=5001

# Node Environment ('development' | 'production' | 'test')
NODE_ENV=development

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/patchpilot

# Allowed CORS Origin
CORS_ORIGIN=http://localhost:5173

# Archive & File Upload Limits (in bytes or counts)
UPLOAD_MAX_SIZE=52428800
MAX_FILES_IN_ARCHIVE=5000
MAX_DECOMPRESSED_SIZE=209715200

# Temporary Directory for scans
TEMP_DIR=

# Optional OpenAI API Key for advanced AI remediation (future extension)
OPENAI_API_KEY=
